{
  "name": "pi-voicekit",
  "version": "0.6.0",
  "description": "Voice in + voice out for Pi CLI — local-only hold-to-talk STT for Chinese and English (21 offline models) plus offline TTS (Kitten Nano, Piper, Kokoro); no audio is uploaded to a remote speech service",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "voice",
    "speech-to-text",
    "stt",
    "local-first",
    "offline",
    "private",
    "privacy",
    "air-gapped",
    "hold-to-talk",
    "voice-input",
    "transcription",
    "streaming",
    "dictation",
    "waveform",
    "terminal",
    "cli",
    "coding-agent",
    "tts",
    "text-to-speech",
    "kitten-tts",
    "piper-tts",
    "kokoro"
  ],
  "author": {
    "name": "codexstar69",
    "url": "https://x.com/baanditeagle"
  },
  "license": "MIT",
  "homepage": "https://github.com/CyFeng16/pi-voicekit#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/CyFeng16/pi-voicekit.git"
  },
  "bugs": {
    "url": "https://github.com/CyFeng16/pi-voicekit/issues"
  },
  "scripts": {
    "typecheck": "bunx tsc -p tsconfig.json",
    "test": "bun test",
    "check": "bun run typecheck && bun run test",
    "format": "prettier --write \"**/*.{ts,json,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,json,yml,yaml}\"",
    "compat:upstream": "node scripts/upstream-compat.mjs",
    "release:dry": "bun run check && bun publish --dry-run"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.87.1",
    "@earendil-works/pi-tui": "^0.87.1",
    "prettier": "3.3.3"
  },
  "overrides": {
    "protobufjs": "^7.6.6",
    "@protobufjs/utf8": "^1.1.2"
  },
  "pi": {
    "extensions": [
      "./extensions/voice.ts"
    ]
  },
  "files": [
    "extensions",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "optionalDependencies": {
    "sherpa-onnx-node": "^1.13.0"
  }
}
